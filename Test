#!/usr/bin/env bash
set -Eeuo pipefail
trap 'ec=$?; echo 1>&2 "INTERNAL ERROR: ec=$ec line=$LINENO cmd=$BASH_COMMAND";
    exit $ec;' ERR

####################################################################

#   First arg is the exit code; remaining args are echoed to stderr.
die()  { ec="$1"; shift; echo 1>&2 "ERROR ($ec):" "$@"; exit $ec; }

#   The `trap` above will print INTERNAL ERROR on unchecked failures. If
#   you're running something you expect may fail, and when it does it's not
#   an error in this script, use `|| fail` to instead fail the build.
fail() { ec=$?; echo "FAILED exitcode=$ec ($(elapsed)s)"; exit $ec; }

warn() { echo 1>&2 "WARNING:" "$@"; }
vecho() { [[ -z $verbose ]] && return 0; echo "$@"; }
notverbose() {
    #   Echo $1 when not verbose, otherwise nothing.
    #   E.g. `$(notverbose --quiet)`.
    [[ -z $verbose ]] && echo $1 || true;
}

elapsed_start=$(date +%s)
elapsed() { echo $(( $(date +%s) - $elapsed_start )); }

####################################################################
#   Build functions

cleanbig() {
    rm -rf "$PROJDIR/.build/"
}

cleansmall() {
    rm -rf "$PROJDIR/.build/"
}

####################################################################
#   Argparse, main

usage() {
    cat <<_____
Usage: Test [OPTS] [-- PYTEST-OPTS]
Options:
  -c        small clean: whatever can be rebuilt quickly
  -C        big clean: everything, but causes slow builds
  -v        verbose mode (multiple use increases verbosity)
  --    pass all subsequent arguments to pytest
_____
}

export PROJDIR=$(cd "$(dirname "$0")" && pwd -P)

verbose=''                              #  zero or more '-v's
while [[ $# -gt 0 ]]; do case "$1" in
    -h|--help)      shift; usage; exit 0;;
    -C)             shift; cleanbig;;
    -c)             shift; cleansmall;;
    -v)             shift; verbose="$verbose -v";;      # add another -v
    --)             shift; break;;
    *)              die 2 "Unknown argument '$1'; use -- before pytest arguments";;
esac; done

source "$PROJDIR"/pactivate $(notverbose -q)
pytest -p pytest_pt -q $verbose "$PROJDIR" "$@" || fail
echo "OK ($(elapsed)s)"
